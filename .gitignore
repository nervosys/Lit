# Secrets & credentials (defense-in-depth)
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.env
.env.*
*.secret
*.credentials
# Keep documentation tracked, but only prose — a blanket `!docs/**` would
# re-include every pattern above for anything placed under docs/, so a
# docs/something.key would be committable.
!docs/**/*.md
!docs/*.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
