# Build artifacts
/target

# Lit repository data
.lit/

# Test artifacts
test_output*.txt
test_full_output.txt
full_test_output.txt
test_results*.txt
lit_test_result.txt
clippy_output.txt
*.log

# Dev scripts
fix_*.ps1
